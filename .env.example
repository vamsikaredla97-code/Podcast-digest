# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Gmail: use an App Password (Google Account → Security → App Passwords)
# Other providers: update SMTP_HOST and SMTP_PORT accordingly
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASSWORD=your_gmail_app_password
EMAIL_TO=vamsikaredla97@gmail.com
EMAIL_FROM=your_gmail_address@gmail.com

# ── Anthropic (Claude AI summaries) ───────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key

# ── Supadata (YouTube transcript fetching) ────────────────────────────────────
# Get your key at https://supadata.ai
SUPADATA_API_KEY=your_supadata_api_key

# ── Notion (digest log database) ──────────────────────────────────────────────
# Create an integration at https://www.notion.so/my-integrations
# Database must have: Title (title), Publication (text), URL (url),
#                     Summary (text), Date (date), Type (select)
NOTION_TOKEN=your_notion_integration_token
NOTION_DATABASE_ID=your_notion_database_id

# ── YouTube Data API v3 (episode link lookup) ─────────────────────────────────
# Enable at https://console.cloud.google.com → YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_data_api_key

# ── Spotify API (optional — adds Spotify episode links) ───────────────────────
# Create app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# ── Timezone ───────────────────────────────────────────────────────────────────
# Used by setup_cron.py. Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=America/New_York
